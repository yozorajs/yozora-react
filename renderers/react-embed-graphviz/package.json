{
  "name": "@yozora/react-embed-graphviz",
  "version": "3.0.0-alpha.17",
  "description": "render graphviz (dot) code",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git",
    "directory": "renderers/react-embed-graphviz"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/tree/main/renderers/react-embed-graphviz#readme",
  "keywords": [
    "mdast node renderer",
    "graphviz renderer"
  ],
  "type": "module",
  "exports": {
    "types": "./lib/types/index.d.ts",
    "import": "./lib/esm/index.mjs",
    "require": "./lib/cjs/index.cjs"
  },
  "source": "./src/index.tsx",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@guanghechen/equal": "^2.0.5",
    "@types/d3-graphviz": "3.1.0",
    "d3-graphviz": "5.6.0",
    "d3-selection": "3.0.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "Firefox ESR",
    "> 1%",
    "ie >= 11"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsdown --config ../../tsdown.config.mjs",
    "watch": "cross-env NODE_ENV=development BUILD_SOURCEMAP=true tsdown --config ../../tsdown.config.mjs -w",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  }
}
