{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "description": "render md data in react",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    ":publish:all": "pnpm -r exec npm version patch --no-git-tag-version && pnpm -r publish --no-git-checks",
    ":upgrade": "pnpm update -i && pnpm clean && pnpm format && pnpm build && pnpm test",
    "build": "cross-env NODE_ENV=production BUILD_SOURCEMAP=true pnpm -r run build",
    "build:production": "cross-env NODE_ENV=production BUILD_SOURCEMAP=false pnpm -r run build",
    "clean": "pnpm -r run clean && pnpm install",
    "format": "biome check --write .",
    "postinstall": "githooks install",
    "rebuild": "pnpm clean && pnpm build",
    "start": "pnpm -r --parallel --if-present run start",
    "test": "pnpm -r run --if-present test",
    "test:coverage": "pnpm -r run --if-present test:coverage",
    "test:update": "pnpm -r run --if-present test:update",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "version": "pnpm install && node script/sync-doc-link.mjs && git stage -u pnpm-lock.yaml packages/**/package.json packages/**/*.md renderers/**/package.json renderers/**/*.md",
    "lint": "biome check .",
    "test:dist": "node script/test-dist.mjs",
    "demo": "pnpm --filter @yozora/demo... build && pnpm --filter @yozora/demo start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@guanghechen/githooks": "1.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "@yozora/ast": "^2.4.1",
    "cross-env": "10.1.0",
    "jsdom": "^30.0.1",
    "lint-staged": "17.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "githooks": {
    "hooks": {
      "pre-commit": "pnpm exec lint-staged --allow-empty"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,cts,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
