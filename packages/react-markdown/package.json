{
  "name": "@yozora/react-markdown",
  "version": "3.0.0-alpha.25",
  "description": "render markdown content in react",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git",
    "directory": "packages/react-markdown"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/tree/release-2.x.x/packages/react-markdown#readme",
  "keywords": [
    "react markdown component"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./style.css": {
      "types": "./lib/style.d.ts",
      "default": "./lib/style.css"
    }
  },
  "source": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@guanghechen/equal": "^2.0.5",
    "@yozora/ast": "^2.4.1",
    "@yozora/react": "workspace:^",
    "@yozora/react-renderer-admonition": "workspace:^",
    "@yozora/react-renderer-code": "workspace:^",
    "@yozora/react-renderer-mathjax": "workspace:^"
  },
  "peerDependencies": {
    "@yozora/ast": "^2.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "browserslist": [
    "Chrome >= 111",
    "Safari >= 16.4",
    "Firefox >= 128",
    "Edge >= 111"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsdown --config ../../tsdown.config.mjs",
    "watch": "cross-env NODE_ENV=development BUILD_SOURCEMAP=true tsdown --config ../../tsdown.config.mjs -w"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
