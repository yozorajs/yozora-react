{
  "name": "@yozora/react-code-literal",
  "version": "3.0.0-alpha.19",
  "description": "render markdown `code` node in react",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git",
    "directory": "packages/react-code-literal"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/tree/release-2.x.x/packages/react-code-literal#readme",
  "keywords": [
    "mdast code renderer",
    "markdown"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./style.css": {
      "types": "./lib/style.d.ts",
      "default": "./lib/style.css"
    }
  },
  "source": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@yozora/react-code-highlighter": "workspace:^",
    "@yozora/react-common-copy-button": "workspace:^",
    "@yozora/react-common-light-buttons": "workspace:^",
    "@yozora/react-core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "browserslist": [
    "Chrome >= 111",
    "Safari >= 16.4",
    "Firefox >= 128",
    "Edge >= 111"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsdown --config ../../tsdown.config.mjs",
    "watch": "cross-env NODE_ENV=development BUILD_SOURCEMAP=true tsdown --config ../../tsdown.config.mjs -w"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
