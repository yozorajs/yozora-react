{
  "name": "@yozora/react-code",
  "version": "3.0.0-alpha.23",
  "description": "render markdown code in react",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git",
    "directory": "packages/react-code"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/tree/release-2.x.x/packages/react-code#readme",
  "keywords": [
    "mdast node renderer",
    "markdown code"
  ],
  "type": "module",
  "exports": {
    "types": "./lib/types/index.d.ts",
    "import": "./lib/esm/index.mjs",
    "require": "./lib/cjs/index.cjs"
  },
  "source": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@guanghechen/equal": "^2.0.5",
    "@yozora/react-code-embed": "workspace:^",
    "@yozora/react-code-literal": "workspace:^",
    "@yozora/react-code-live": "workspace:^",
    "@yozora/react-code-renderer-jsx": "workspace:^",
    "@yozora/react-core": "workspace:^"
  },
  "peerDependencies": {
    "@emotion/css": "^11.0.0",
    "@yozora/ast": "^2.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "Firefox ESR",
    "> 1%",
    "ie >= 11"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsdown --config ../../tsdown.config.mjs",
    "watch": "cross-env NODE_ENV=development BUILD_SOURCEMAP=true tsdown --config ../../tsdown.config.mjs -w",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  }
}
