{
  "name": "@yozora/react-embed-math",
  "version": "3.0.0-alpha.17",
  "description": "render formula with mathjax in react",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git",
    "directory": "packages/react-embed-math"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/tree/main/packages/react-embed-math#readme",
  "keywords": [
    "mathjax",
    "react"
  ],
  "type": "module",
  "exports": {
    "types": "./lib/types/index.d.ts",
    "import": "./lib/esm/index.mjs",
    "require": "./lib/cjs/index.cjs"
  },
  "source": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@guanghechen/equal": "^2.0.5",
    "@yozora/react": "workspace:^"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mathjax/src": "^4.1.3"
  },
  "browserslist": [
    "last 2 versions",
    "Firefox ESR",
    "> 1%"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsdown --config ../../tsdown.config.mjs",
    "watch": "cross-env NODE_ENV=development BUILD_SOURCEMAP=true tsdown --config ../../tsdown.config.mjs -w",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  }
}
