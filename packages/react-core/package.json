{
  "name": "@yozora/react-core",
  "version": "3.0.0-alpha.0",
  "description": "Shared theme, constants, types, and utilities for Yozora React.",
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yozorajs/yozora-react.git",
    "directory": "packages/react-core"
  },
  "homepage": "https://github.com/yozorajs/yozora-react/tree/main/packages/react-core#readme",
  "keywords": [],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./style.css": {
      "types": "./lib/style.d.ts",
      "default": "./lib/style.css"
    }
  },
  "source": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "license": "MIT",
  "files": [
    "lib/",
    "!lib/**/*.map",
    "package.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@guanghechen/parse-lineno": "^2.3.10"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsdown --config ../../tsdown.config.mjs",
    "watch": "cross-env NODE_ENV=development BUILD_SOURCEMAP=true tsdown --config ../../tsdown.config.mjs -w",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "test:update": "vitest run --config ../../vitest.config.ts -u"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": [
    "Chrome >= 111",
    "Safari >= 16.4",
    "Firefox >= 128",
    "Edge >= 111"
  ]
}
