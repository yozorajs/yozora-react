{
  "name": "@yozora/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "start": "node serve.mjs",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@yozora/react-embed-mermaid": "workspace:^",
    "@yozora/react-gfm": "workspace:^",
    "@yozora/react-gfm-ex": "workspace:^",
    "@yozora/react-renderer": "workspace:^",
    "@yozora/react-renderer-code": "workspace:^",
    "@yozora/react-yozora": "workspace:^",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@mathjax/src": "^4.1.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
